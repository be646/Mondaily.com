{
  "buildCommand": "npx tsup && (node scripts/log-deploy.mjs || true)",
  "regions": ["fra1"],
  "functions": {
    "api/handler.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/handler" }
  ],
  "crons": [
    { "path": "/api/cron/daily", "schedule": "0 6 * * *" },
    { "path": "/api/cron/monitors", "schedule": "0 */4 * * *" },
    { "path": "/api/cron/executive-brief", "schedule": "0 7 1 * *" },
    { "path": "/api/cron/period-close", "schedule": "5 * * * *" },
    { "path": "/api/cron/support-reminders", "schedule": "0 9 * * *" }
  ]
}
