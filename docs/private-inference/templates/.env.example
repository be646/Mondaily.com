# TEMPLATE — private inference env. Copy to `.env` on the GPU host; set real values; never commit.
# Inert in this repo. Two groups: (A) operator/host secrets, (B) the Vercel env changed LATER.

# ─────────────────────────────────────────────────────────────────────────────
# (A) GPU HOST / OPERATOR  — used by docker-compose + proxy on the private node
# ─────────────────────────────────────────────────────────────────────────────
# API key the reverse proxy requires from callers (== AI_GATEWAY_API_KEY in Vercel).
PROXY_API_KEY=replace-with-strong-random    # e.g. openssl rand -hex 32
# API key vLLM itself checks (proxy forwards it). Can equal PROXY_API_KEY or differ.
VLLM_API_KEY=replace-with-strong-random
# HuggingFace token for gated model downloads (Llama etc.). Leave blank for open models.
HF_TOKEN=
# Served model names — MUST match --served-model-name in docker-compose.
SMALL_SERVED_NAME=qwen2.5-14b
LARGE_SERVED_NAME=llama-70b

# ─────────────────────────────────────────────────────────────────────────────
# (B) VERCEL (API project) — set LATER, at canary, one class at a time.
#     DO NOT set these now. Listed here so the mapping is unambiguous.
# ─────────────────────────────────────────────────────────────────────────────
# Sovereign gateway endpoint — point at the private proxy (keep hosted until cutover).
# AI_GATEWAY_BASE_URL=https://<proxy-host>/v1
# AI_GATEWAY_API_KEY=<== PROXY_API_KEY>
# Observability label shown in ai_usage.provider (non-secret).
# AI_BACKEND_LABEL=vllm-private
# CANARY #1 — extraction only. Everything else stays on the hosted spec.
# AI_MODEL_EXTRACTION=openai-compat/qwen2.5-14b
# Promote AFTER extraction holds (support/chat), then LAST the large tier:
# AI_MODEL_SUPPORT=openai-compat/qwen2.5-14b
# AI_MODEL_FAST=openai-compat/qwen2.5-14b
# AI_MODEL_SUMMARIZATION=openai-compat/llama-70b
# AI_MODEL_MEETING=openai-compat/llama-70b
# AI_MODEL_REASONING=openai-compat/llama-70b
