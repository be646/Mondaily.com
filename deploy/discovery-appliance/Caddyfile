# Bearer-token edge for the Discovery appliance. Every request to :8080 (search) and
# :3002 (scraper) must carry `Authorization: Bearer <APPLIANCE_TOKEN>` — the exact header
# the Mondaily API sends when SOVEREIGN_SEARCH_KEY is set. Anything else gets 401, which the
# API's /discovery/status probe reports as "up but rejecting (401) — key mismatch".
#
# NOTE: this is plain HTTP on an IP. The token protects access, but traffic isn't encrypted.
# Once you point a domain at the box, switch these blocks to `search.yourdomain:443 { ... }`
# and Caddy will provision TLS automatically — then use https:// URLs in Vercel.

{
	admin off
	auto_https off
}

# ── Search edge (SearXNG JSON API) ──
:8080 {
	@unauthorized not header Authorization "Bearer {$APPLIANCE_TOKEN}"
	respond @unauthorized "unauthorized" 401
	reverse_proxy searxng:8080
}

# ── Scraper edge (Playwright → Markdown) ──
:3002 {
	@unauthorized not header Authorization "Bearer {$APPLIANCE_TOKEN}"
	respond @unauthorized "unauthorized" 401
	reverse_proxy scraper:3002
}
