# ─────────────────────────────────────────────────────────────────────────────
# Mondaily environment — sovereign-first.
# CORE = required for the sovereign claim. OPTIONAL = customer-authorized
# connectors (never core AI infrastructure). See SOVEREIGNTY.md for the full map.
# ─────────────────────────────────────────────────────────────────────────────

# ── CORE: Database (Postgres / Supabase-compatible) ──────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── CORE: Sovereign auth (native email/password + signed cookie sessions) ────
# Generate: openssl rand -hex 32
AUTH_JWT_SECRET=

# ── CORE: Sovereign AI gateway — the ONE and ONLY inference endpoint. ─────────
# OpenAI-compatible PROTOCOL only (used as a client with an explicit baseURL);
# NOT an OpenAI dependency. Fails CLOSED if unset — no default public endpoint,
# no OpenAI/Anthropic/Cerebras-specific fallback.
#
# Hosted gateway (e.g. Cerebras) = "sovereign-compatible".
# True 100% sovereignty = self-hosted / private-cloud open-weight inference:
#   vLLM     → AI_GATEWAY_BASE_URL=http://your-host:8000/v1
#   Ollama   → AI_GATEWAY_BASE_URL=http://your-host:11434/v1
#   TGI      → AI_GATEWAY_BASE_URL=http://your-host:8080/v1
#   (any OpenAI-compatible open-weight server on infra you control)
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
# Optional model overrides (defaults are set in code)
AI_MODEL=
AI_FAST_MODEL=

# ── CORE: Sovereign search + scraper (self-hosted SearXNG + Playwright) ───────
# Discovery/enrichment route ONLY through these. Fail loud in production if unset
# (no localhost fallback, no third-party search). See deploy/discovery-appliance.
SOVEREIGN_SEARCH_URL=
SOVEREIGN_SEARCH_KEY=
SOVEREIGN_SCRAPE_URL=
# Optional: pin SearXNG engines (default: qwant,yahoo)
SOVEREIGN_SEARCH_ENGINES=

# ── CORE: Background jobs + cron protection ──────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Locks /api/cron/* — generate: openssl rand -hex 32
CRON_SECRET=

# ── CORE: App URLs ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=     # marketing web → backend public ask route ONLY
VITE_API_URL=            # app SPA → backend
VITE_APP_URL=
NEXT_PUBLIC_APP_URL=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL customer-authorized connectors — NOT core AI infrastructure. Each is
# inert until a customer connects it; every one is surfaced honestly in /status.
# ─────────────────────────────────────────────────────────────────────────────

# Payments (Stripe) — card data lives with Stripe; Mondaily never stores it.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_OPERATOR_MONTH=
STRIPE_PRICE_COMMAND_MONTH=

# Google (Gmail + Calendar) — direct OAuth, read/reply after user connects.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft (Outlook + Calendar) — direct Graph OAuth.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Voice/video calls (LiveKit) — OPTIONAL realtime; sovereign only when self-hosted.
# Missing = calls show "not configured" and fail closed (nothing breaks).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Reddit (Discovery intent signal) — app-only OAuth; inert without these.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Google Places (Discovery business enrichment) — optional connector.
GOOGLE_PLACES_API_KEY=

# Transactional email (sign-in codes, notifications) — optional.
RESEND_API_KEY=
