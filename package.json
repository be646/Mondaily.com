{
  "name": "mondaily",
  "version": "0.1.0",
  "private": true,
  "description": "Mondaily AI business operating system monorepo",
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint apps/app/src packages/api/src packages/shared/src",
    "typecheck": "turbo typecheck",
    "test": "pnpm --filter @mondaily/api test",
    "audit:sovereignty": "bash scripts/audit/sovereignty-audit.sh",
    "audit:isolation": "node scripts/audit/workspace-isolation-scan.mjs",
    "audit": "pnpm run audit:sovereignty && pnpm run audit:isolation",
    "readiness:live": "node scripts/audit/live-readiness.mjs",
    "e2e": "playwright test --project=public --project=setup",
    "e2e:auth": "playwright test",
    "eval:ai:dry-run": "node scripts/ai-eval/harness.mjs --dry-run",
    "eval:ai:offline": "node scripts/ai-eval/harness.mjs --offline",
    "backup": "node scripts/backup/export.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  }
}
